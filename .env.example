# Copy this file to `.env` (cp .env.example .env) and fill in ONE provider key. Never commit `.env`.
# Lines starting with # are comments. Empty values are ignored.

# ---- 1. LLM provider key (you need at least one; without any, the app runs in demo mode) ----
GROQ_API_KEY=            # https://console.groq.com/keys (free tier)
GEMINI_API_KEY=          # https://aistudio.google.com/apikey (free tier)

# ---- 2. Which model the APP uses (optional; defaults come from configs/best.yaml) ----
T2S_PROVIDER=groq                # groq | gemini | ollama | openai_compat
T2S_MODEL=openai/gpt-oss-120b    # e.g. gemini-2.5-flash for gemini; qwen2.5-coder:7b for ollama
T2S_FALLBACK=                    # optional "provider:model" tried if the primary fails, e.g. gemini:gemini-2.5-flash

# ---- 3. Local / custom models (optional) ----
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=
OPENAI_BASE_URL=                 # any OpenAI-compatible server (used when T2S_PROVIDER=openai_compat)
OPENAI_API_KEY=

# ---- 4. Limits and paths (optional; sensible defaults) ----
T2S_DAILY_CAP=500                # max requests/day the server answers
T2S_MAX_UPLOAD_MB=50             # per uploaded file
T2S_MAX_DATASETS=20              # uploaded datasets kept in memory
# T2S_UPLOAD_DIR=.cache/uploads  T2S_CACHE_DIR=.cache/llm  T2S_AUDIT_LOG=logs/audit.jsonl
# T2S_CONFIG=configs/best.yaml   T2S_EMBEDDER=hash|bge   T2S_API_URL=http://localhost:8000
